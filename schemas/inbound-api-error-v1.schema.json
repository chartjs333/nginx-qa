{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chartjs333/nginx-qa/schemas/inbound-api-error-v1.schema.json",
  "title": "Inbound proposal API error v1",
  "type": "object",
  "required": ["detail"],
  "properties": {
    "detail": {
      "type": "object",
      "required": ["error", "correlation_id", "retryable"],
      "properties": {
        "error": {
          "enum": [
            "PROPOSAL_REQUEST_INVALID",
            "PROPOSAL_AUTH_REQUIRED",
            "PROPOSAL_FORBIDDEN",
            "PROPOSAL_PROJECT_NOT_FOUND",
            "PROPOSAL_NOT_FOUND",
            "PROPOSAL_IDEMPOTENCY_CONFLICT",
            "PROPOSAL_ID_CONFLICT",
            "PROPOSAL_REVISION_CONFLICT",
            "PROPOSAL_STATE_CONFLICT",
            "PROPOSAL_REQUEST_TOO_LARGE",
            "PROPOSAL_STORAGE_FAILED",
            "PROPOSAL_SERVICE_UNAVAILABLE"
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 1000},
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "retryable": {"type": "boolean"},
        "field": {"type": "string", "minLength": 1, "maxLength": 256},
        "proposal_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_revision": {"type": "integer", "minimum": 0},
        "actual_revision": {"type": "integer", "minimum": 0},
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
              "field": {"type": "string", "minLength": 1, "maxLength": 256},
              "message": {"type": "string", "minLength": 1, "maxLength": 1000}
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "error": {"const": "PROPOSAL_SERVICE_UNAVAILABLE"}
            },
            "required": ["error"]
          },
          "then": {"properties": {"retryable": {"const": true}}},
          "else": {"properties": {"retryable": {"const": false}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
