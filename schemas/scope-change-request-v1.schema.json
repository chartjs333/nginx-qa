{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scope-change-request-v1.schema.json",
  "title": "Human scope change request: semantic boundaries, not a graph mutation",
  "type": "object", "additionalProperties": false,
  "required": ["assignment_id", "expected_execution_revision", "expected_scope_revision", "idempotency_key", "reason", "proposal", "source"],
  "properties": {
    "assignment_id": {"type": "string", "minLength": 1},
    "expected_execution_revision": {"type": "integer", "minimum": 0},
    "expected_scope_revision": {"type": "integer", "minimum": 0},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200},
    "reason": {"type": "string", "minLength": 1, "maxLength": 65536},
    "dependencies": {"type": "array", "items": {"type": "string", "maxLength": 8192}},
    "proposal": {"$ref": "#/$defs/proposal"}, "source": {"$ref": "#/$defs/source"},
    "authorization_provenance": {"type": ["object", "null"], "properties": {"kind": {"const": "existing_human_authorization"}, "reference": {"type": "string"}}, "required": ["kind", "reference"], "additionalProperties": false}
  },
  "$defs": {
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["instructions", "retained_restrictions", "node_ids", "reviewer_ids"],
      "properties": {
        "instructions": {"type": "string", "minLength": 1, "maxLength": 65536},
        "retained_restrictions": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 8192}},
        "node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 8192}},
        "reviewer_ids": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 8192}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["repository_key", "commit", "path"],
      "properties": {"repository_key": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
