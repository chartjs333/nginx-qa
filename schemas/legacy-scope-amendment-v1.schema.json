{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chartjs333/nginx-qa/schemas/legacy-scope-amendment-v1.schema.json",
  "title": "Legacy conditional-graph scope amendment request v1",
  "type": "object",
  "required": [
    "schema_version",
    "amendment_id",
    "expected_execution_revision",
    "expected_assignment_id",
    "expected_node_id",
    "expected_phase",
    "expected_issued_task_sha256",
    "expected_issued_message_sha256",
    "idempotency_key",
    "source",
    "targets"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "amendment_id": {"$ref": "#/$defs/id"},
    "expected_execution_revision": {"type": "integer", "minimum": 1},
    "expected_assignment_id": {"$ref": "#/$defs/id"},
    "expected_node_id": {"$ref": "#/$defs/id"},
    "expected_phase": {"const": "node"},
    "expected_issued_task_sha256": {"$ref": "#/$defs/sha256"},
    "expected_issued_message_sha256": {"$ref": "#/$defs/sha256"},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 200},
    "source": {"$ref": "#/$defs/source"},
    "targets": {"$ref": "#/$defs/targets"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "blob": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["path", "base_sha256", "target_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "base_sha256": {"$ref": "#/$defs/sha256"},
        "target_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "repository_key",
        "base_commit",
        "target_commit",
        "target_ref",
        "manifest",
        "amendment"
      ],
      "properties": {
        "repository_key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9.-]+(?::[0-9]+)?/[A-Za-z0-9._/-]+$"
        },
        "base_commit": {"$ref": "#/$defs/commit"},
        "target_commit": {"$ref": "#/$defs/commit"},
        "target_ref": {
          "type": "string",
          "minLength": 12,
          "maxLength": 300,
          "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "manifest": {"$ref": "#/$defs/manifest"},
        "amendment": {"$ref": "#/$defs/blob"},
        "supporting_documents": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/blob"}
        }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "object",
      "required": [
        "active_assignment",
        "future_node_ids",
        "reviewer_agent_ids"
      ],
      "properties": {
        "active_assignment": {"const": true},
        "future_node_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nodeId"}
        },
        "reviewer_agent_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nodeId"}
        },
        "terminal_node_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nodeId"}
        }
      },
      "additionalProperties": false
    }
  }
}
