{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chartjs333/nginx-qa/schemas/repair-sprint-v1.schema.json",
  "title": "Managed sprint future-graph repair request v1",
  "type": "object",
  "required": [
    "expected_revision",
    "repair_source_commit",
    "idempotency_key",
    "patch"
  ],
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "repair_source_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "patch": {"$ref": "#/$defs/repairPatch"}
  },
  "additionalProperties": false,
  "$defs": {
    "repairPatch": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "future_nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "managed-workspace-sprint-v1.schema.json#/$defs/taskNode"},
              {"$ref": "managed-workspace-sprint-v1.schema.json#/$defs/terminalNode"}
            ]
          }
        },
        "remove_future_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "managed-workspace-sprint-v1.schema.json#/$defs/nodeId"}
        },
        "prompts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "managed-workspace-sprint-v1.schema.json#/$defs/nodeId"},
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"type": "string", "minLength": 1, "maxLength": 160},
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "managed-workspace-sprint-v1.schema.json#/$defs/nodeId"},
          "additionalProperties": {"type": "string"}
        },
        "reviewer_metadata": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "managed-workspace-sprint-v1.schema.json#/$defs/reviewer"}
        },
        "coordinator_routing": {
          "$ref": "managed-workspace-sprint-v1.schema.json#/$defs/coordinator"
        },
        "checksum_metadata": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "managed-workspace-sprint-v1.schema.json#/$defs/checksumFile"}
        }
      },
      "additionalProperties": false
    }
  }
}
