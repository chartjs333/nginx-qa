{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chartjs333/nginx-qa/schemas/start-sprint-from-git-response-v1.schema.json",
  "title": "Start managed sprint from Git response v1",
  "type": "object",
  "required": [
    "sprint_id",
    "status",
    "phase",
    "deduplicated",
    "execution_mode",
    "identity",
    "workspace_source_commit",
    "initial_assignment_ids"
  ],
  "properties": {
    "sprint_id": {"type": "string", "pattern": "^msv1-[0-9a-f]{64}$"},
    "status": {"const": "active"},
    "phase": {"const": "ACTIVATE"},
    "deduplicated": {"type": "boolean"},
    "execution_mode": {"enum": ["sequential", "parallel"]},
    "identity": {
      "type": "object",
      "required": [
        "project_id",
        "repository_id",
        "commit",
        "manifest_path",
        "manifest_sha256"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9_-])?$"
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,94}[A-Za-z0-9_-])?$"
        },
        "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "workspace_source_commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "initial_assignment_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"execution_mode": {"const": "sequential"}},
        "required": ["execution_mode"]
      },
      "then": {
        "properties": {"initial_assignment_ids": {"maxItems": 1}}
      }
    }
  ],
  "additionalProperties": false
}
