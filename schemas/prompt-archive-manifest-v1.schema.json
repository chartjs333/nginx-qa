{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chartjs333/nginx-qa/schemas/prompt-archive-manifest-v1.schema.json",
  "title": "Prompt archive immutable manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "media_type",
    "id_algorithm",
    "archive_id",
    "archive_format",
    "scope",
    "source",
    "authorization",
    "roots",
    "integrity",
    "counts",
    "limits",
    "publication",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "prompt_archive_manifest"},
    "media_type": {
      "const": "application/vnd.nginx-qa.prompt-archive-manifest-v1+json"
    },
    "id_algorithm": {"const": "PAS1-ID-v1"},
    "archive_id": {
      "type": "string",
      "pattern": "^par1-[0-9a-f]{64}$"
    },
    "archive_format": {
      "enum": ["legacy_raw_chunks_v1", "incremental_transition_v1"]
    },
    "scope": {"$ref": "#/$defs/scope"},
    "source": {"$ref": "#/$defs/source"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "source_metadata_receipt": {
      "$ref": "#/$defs/sourceMetadataReceipt"
    },
    "renderer_version": {
      "description": "The frozen renderer that combines the exact response envelope with the named persistent sequences. Required only for incremental_transition_v1.",
      "const": "pas1-concat-renderer-v1"
    },
    "json_value_model": {
      "description": "The frozen recursive exact-byte JSON Merkle model. Required only for incremental_transition_v1.",
      "const": "pas1-recursive-json-merkle-v1"
    },
    "envelope": {"$ref": "#/$defs/envelope"},
    "roots": {"$ref": "#/$defs/roots"},
    "integrity": {"$ref": "#/$defs/integrity"},
    "legacy_comparison": {"$ref": "#/$defs/legacyComparison"},
    "counts": {"$ref": "#/$defs/counts"},
    "limits": {"$ref": "#/$defs/limits"},
    "publication": {"$ref": "#/$defs/publication"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"archive_format": {"const": "legacy_raw_chunks_v1"}},
        "required": ["archive_format"]
      },
      "then": {
        "properties": {
          "roots": {
            "required": ["raw_bytes"],
            "maxProperties": 1
          },
          "integrity": {
            "required": ["semantics"],
            "properties": {"semantics": {"const": "raw-byte-equality"}}
          },
          "source": {
            "required": ["source_kind"],
            "properties": {
              "source_kind": {
                "const": "offline_migration"
              }
            }
          }
        },
        "allOf": [
          {"not": {"required": ["renderer_version"]}},
          {"not": {"required": ["json_value_model"]}},
          {"not": {"required": ["envelope"]}},
          {"not": {"required": ["legacy_comparison"]}}
        ]
      }
    },
    {
      "if": {"required": ["source_metadata_receipt"]},
      "then": {
        "properties": {"roots": {"required": ["source_metadata"]}}
      },
      "else": {
        "properties": {
          "roots": {"not": {"required": ["source_metadata"]}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "archive_format": {"const": "incremental_transition_v1"}
        },
        "required": ["archive_format"]
      },
      "then": {
        "required": ["renderer_version", "json_value_model", "envelope"],
        "properties": {
          "roots": {"not": {"required": ["raw_bytes"]}},
          "integrity": {
            "required": ["semantics"],
            "properties": {"semantics": {"const": "native-byte-equality"}}
          },
          "source": {
            "required": ["source_kind"],
            "properties": {
              "source_kind": {
                "enum": ["runtime_shadow", "native_runtime"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archive_format": {"const": "incremental_transition_v1"},
          "source": {
            "properties": {"source_kind": {"const": "runtime_shadow"}},
            "required": ["source_kind"]
          }
        },
        "required": ["archive_format", "source"]
      },
      "then": {"required": ["legacy_comparison"]},
      "else": {"not": {"required": ["legacy_comparison"]}}
    },
    {
      "oneOf": [
        {
          "required": ["renderer_version", "envelope", "legacy_comparison"],
          "properties": {
            "archive_format": {"const": "incremental_transition_v1"},
            "source": {
              "required": ["source_kind"],
              "properties": {"source_kind": {"const": "runtime_shadow"}}
            },
            "publication": {
              "required": ["mode", "legacy_authoritative"],
              "properties": {
                "mode": {"const": "shadow"},
                "legacy_authoritative": {"const": true}
              }
            }
          }
        },
        {
          "properties": {
            "archive_format": {"const": "legacy_raw_chunks_v1"},
            "source": {
              "required": ["source_kind"],
              "properties": {"source_kind": {"const": "offline_migration"}}
            },
            "publication": {
              "required": ["mode", "legacy_authoritative"],
              "properties": {
                "mode": {"const": "migration"},
                "legacy_authoritative": {"const": true}
              }
            }
          }
        },
        {
          "required": ["renderer_version", "envelope"],
          "properties": {
            "archive_format": {"const": "incremental_transition_v1"},
            "source": {
              "required": ["source_kind"],
              "properties": {"source_kind": {"const": "native_runtime"}}
            },
            "publication": {
              "required": [
                "mode",
                "legacy_authoritative",
                "operator_gate"
              ],
              "properties": {
                "mode": {"const": "authoritative"},
                "legacy_authoritative": {"const": false},
                "operator_gate": {"const": "prompt-archive-authoritative-v1"}
              }
            }
          },
          "not": {"required": ["legacy_comparison"]}
        }
      ]
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "source_kind": {
                "enum": ["runtime_shadow", "native_runtime"]
              }
            },
            "required": ["source_kind"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "sprint_id": {"$ref": "#/$defs/safeId"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mediaType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*(?:;[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*=[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*)*$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "scope": {
      "type": "object",
      "required": [
        "project_id",
        "sprint_id",
        "response_id",
        "response_kind",
        "occurrence_kind",
        "occurrence_id",
        "transition_id"
      ],
      "properties": {
        "project_id": {"$ref": "#/$defs/safeId"},
        "sprint_id": {
          "oneOf": [
            {"$ref": "#/$defs/safeId"},
            {"type": "null"}
          ]
        },
        "response_id": {
          "type": "string",
          "pattern": "^parresp1-[0-9a-f]{64}$"
        },
        "response_kind": {
          "enum": [
            "identity-response",
            "transition-response",
            "state-response",
            "migration-snapshot"
          ]
        },
        "occurrence_kind": {
          "enum": ["transition", "identity-state", "migration"]
        },
        "occurrence_id": {"$ref": "#/$defs/safeId"},
        "transition_id": {
          "oneOf": [
            {"$ref": "#/$defs/safeId"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"occurrence_kind": {"const": "transition"}},
            "required": ["occurrence_kind"]
          },
          "then": {"properties": {"transition_id": {"$ref": "#/$defs/safeId"}}},
          "else": {"properties": {"transition_id": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {"occurrence_kind": {"const": "migration"}},
            "required": ["occurrence_kind"]
          },
          "then": {"properties": {"response_kind": {"const": "migration-snapshot"}}}
        }
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["source_kind"],
      "properties": {
        "source_kind": {
          "enum": [
            "runtime_shadow",
            "native_runtime",
            "offline_migration"
          ]
        },
        "source_commit": {"$ref": "#/$defs/gitObjectId"},
        "assignment_id": {"$ref": "#/$defs/safeId"},
        "review_id": {"$ref": "#/$defs/safeId"},
        "result_key": {"$ref": "#/$defs/safeId"},
        "predecessor_archive_id": {
          "oneOf": [
            {"type": "string", "pattern": "^par1-[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "sourceMetadataReceipt": {
      "description": "Closed cross-binding for the canonical screened source-metadata projection stored as exactly one non-rendered source_metadata record. Runtime validation also compares every bound value to the hydrated sidecar root.",
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "projection_version",
        "redaction_version",
        "projection_sha256",
        "projection_byte_size",
        "source_type",
        "discarded_field_count",
        "projected_fields"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {
          "const": "prompt_archive_source_metadata_projection_receipt"
        },
        "projection_version": {
          "const": "prompt-archive-source-projection-v1"
        },
        "redaction_version": {
          "const": "prompt-archive-source-redaction-v1"
        },
        "projection_sha256": {"$ref": "#/$defs/sha256"},
        "projection_byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "source_type": {
          "enum": ["api", "email", "folder", "manual", "telegram", "unknown"]
        },
        "discarded_field_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "projected_fields": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "conversation_id",
              "thread_id",
              "message_id",
              "observed_at",
              "sender_label",
              "title"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "description": "Closed non-secret provenance for the authorization decision. No token, credential reference, cookie, header, payload, or filesystem path is permitted.",
      "type": "object",
      "required": [
        "auth_model_version",
        "principal_kind",
        "principal_id",
        "binding_id",
        "scope_source",
        "effective_scope_revision",
        "effective_scope_sha256",
        "decision_occurrence_id"
      ],
      "properties": {
        "auth_model_version": {
          "const": "prompt-archive-authorization-v1"
        },
        "principal_kind": {
          "enum": [
            "managed_agent",
            "legacy_local_principal",
            "offline_operator",
            "synthetic_test"
          ]
        },
        "principal_id": {"$ref": "#/$defs/safeId"},
        "binding_id": {
          "oneOf": [
            {"$ref": "#/$defs/safeId"},
            {"type": "null"}
          ]
        },
        "scope_source": {
          "enum": [
            "managed_effective_scope",
            "legacy_project_context",
            "offline_operator_gate",
            "synthetic_test"
          ]
        },
        "effective_scope_revision": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {"type": "null"}
          ]
        },
        "effective_scope_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "decision_occurrence_id": {"$ref": "#/$defs/safeId"}
      },
      "oneOf": [
        {
          "properties": {
            "principal_kind": {"const": "managed_agent"},
            "binding_id": {"$ref": "#/$defs/safeId"},
            "scope_source": {"const": "managed_effective_scope"},
            "effective_scope_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "effective_scope_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "properties": {
            "principal_kind": {"const": "legacy_local_principal"},
            "binding_id": {"type": "null"},
            "scope_source": {"const": "legacy_project_context"},
            "effective_scope_revision": {"type": "null"},
            "effective_scope_sha256": {"type": "null"}
          }
        },
        {
          "properties": {
            "principal_kind": {"const": "offline_operator"},
            "binding_id": {"type": "null"},
            "scope_source": {"const": "offline_operator_gate"},
            "effective_scope_revision": {"type": "null"},
            "effective_scope_sha256": {"type": "null"}
          }
        },
        {
          "properties": {
            "principal_kind": {"const": "synthetic_test"},
            "binding_id": {"type": "null"},
            "scope_source": {"const": "synthetic_test"},
            "effective_scope_revision": {"type": "null"},
            "effective_scope_sha256": {"type": "null"}
          }
        }
      ],
      "additionalProperties": false
    },
    "indexRef": {
      "allOf": [
        {"$ref": "prompt-archive-ref-v1.schema.json"},
        {
          "required": ["logical_kind"],
          "properties": {"logical_kind": {"const": "index_node"}}
        }
      ]
    },
    "envelope": {
      "description": "The non-cumulative response render plan. byte_size and sha256 bind the exact concatenation of render_plan_chunk bytes reachable from chunks_root. The referenced root must semantically resolve to a render_plan_chunks index whose totals match these fields.",
      "type": "object",
      "required": ["media_type", "byte_size", "sha256", "chunks_root"],
      "properties": {
        "media_type": {
          "const": "application/vnd.nginx-qa.prompt-response-envelope-v1+json"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "chunks_root": {"$ref": "#/$defs/indexRef"}
      },
      "additionalProperties": false
    },
    "roots": {
      "description": "Runtime-native manifests carry current_fields exactly when the frozen render plan has one or more current_field spans; empty historical families omit their roots. legacy_raw_chunks_v1 requires raw_bytes exclusively.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "raw_bytes": {"$ref": "#/$defs/indexRef"},
        "current_fields": {"$ref": "#/$defs/indexRef"},
        "recent_activity": {"$ref": "#/$defs/indexRef"},
        "history_text": {"$ref": "#/$defs/indexRef"},
        "history_timeline": {"$ref": "#/$defs/indexRef"},
        "activity_with_patches": {"$ref": "#/$defs/indexRef"},
        "history_patches": {"$ref": "#/$defs/indexRef"},
        "code_patches": {"$ref": "#/$defs/indexRef"},
        "work_history": {"$ref": "#/$defs/indexRef"},
        "review_context": {"$ref": "#/$defs/indexRef"},
        "results": {"$ref": "#/$defs/indexRef"},
        "feedback": {"$ref": "#/$defs/indexRef"},
        "execution_audit": {"$ref": "#/$defs/indexRef"},
        "source_metadata": {"$ref": "#/$defs/indexRef"}
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": [
        "semantics",
        "hydrated_media_type",
        "hydrated_size",
        "hydrated_sha256"
      ],
      "properties": {
        "semantics": {"enum": ["raw-byte-equality", "native-byte-equality"]},
        "hydrated_media_type": {"const": "application/json"},
        "hydrated_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "hydrated_sha256": {"$ref": "#/$defs/sha256"},
        "canonical": {
          "type": "object",
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": {"const": "nginx-qa-canonical-json-v1"},
            "digest": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "legacyComparison": {
      "description": "Exact shadow comparison evidence. byte_size and sha256 must semantically equal the rendered hydrated byte length and digest; Draft 2020-12 cannot express that sibling-field equality.",
      "type": "object",
      "required": ["byte_size", "sha256", "renderer_version", "matched"],
      "properties": {
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "renderer_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "matched": {"const": true}
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "records",
        "raw_chunks",
        "payload_chunks",
        "literal_chunks",
        "render_plan_chunks",
        "json_value_nodes",
        "json_edges",
        "index_nodes",
        "unique_referenced_objects",
        "graph_edges",
        "logical_bytes",
        "referenced_stored_bytes",
        "referenced_uncompressed_bytes"
      ],
      "properties": {
        "records": {"type": "integer", "minimum": 0},
        "raw_chunks": {"type": "integer", "minimum": 0},
        "payload_chunks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "literal_chunks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "render_plan_chunks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "json_value_nodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "json_edges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "index_nodes": {"type": "integer", "minimum": 0},
        "unique_referenced_objects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "graph_edges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "logical_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "referenced_stored_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 805306368
        },
        "referenced_uncompressed_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 805306368
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "profile",
        "max_blob_uncompressed_bytes",
        "max_blob_stored_bytes",
        "max_manifest_bytes",
        "max_hydrated_bytes",
        "max_render_literal_bytes",
        "max_referenced_stored_bytes",
        "max_referenced_uncompressed_bytes",
        "max_reference_depth",
        "max_reference_count",
        "max_index_fanout",
        "max_control_json_depth",
        "max_json_value_depth",
        "max_json_value_nodes",
        "max_json_edges",
        "max_compression_ratio"
      ],
      "properties": {
        "profile": {"const": "prompt-archive-limits-v1"},
        "max_blob_uncompressed_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_blob_stored_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16842752
        },
        "max_manifest_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_hydrated_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "max_render_literal_bytes": {
          "description": "Fixed V1 aggregate ceiling for the sum of envelope literal-step byte_size values.",
          "const": 8388608
        },
        "max_referenced_stored_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 805306368
        },
        "max_referenced_uncompressed_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 805306368
        },
        "max_reference_depth": {
          "description": "Fixed V1 graph-depth ceiling, including recursive JSON value, index, edge, and child-value reference hops.",
          "const": 512
        },
        "max_reference_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_index_fanout": {"const": 64},
        "max_control_json_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max_json_value_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "max_json_value_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_json_edges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_compression_ratio": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": [
        "mode",
        "legacy_authoritative",
        "writer_version",
        "verified_at"
      ],
      "properties": {
        "mode": {"enum": ["shadow", "migration", "authoritative"]},
        "legacy_authoritative": {"type": "boolean"},
        "operator_gate": {
          "const": "prompt-archive-authoritative-v1"
        },
        "writer_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "verified_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "authoritative"}},
            "required": ["mode"]
          },
          "then": {
            "required": ["operator_gate"],
            "properties": {"legacy_authoritative": {"const": false}}
          },
          "else": {
            "properties": {"legacy_authoritative": {"const": true}},
            "not": {"required": ["operator_gate"]}
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
