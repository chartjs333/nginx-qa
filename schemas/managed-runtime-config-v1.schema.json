{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chartjs333/nginx-qa/schemas/managed-runtime-config-v1.schema.json",
  "title": "Normalized managed runtime configuration v1",
  "type": "object",
  "required": [
    "http_host",
    "http_port",
    "service_root",
    "protected_roots",
    "runtime_root",
    "process_runtime_root",
    "log_root",
    "pid_root",
    "lease_root",
    "prompt_root",
    "managed_root",
    "git_fetch_timeout_seconds",
    "child_port_start",
    "child_port_end",
    "instance_id",
    "disable_telegram",
    "disable_tunnel"
  ],
  "properties": {
    "http_host": {"type": "string", "minLength": 1, "x-env": "NGINX_QA_HTTP_HOST"},
    "http_port": {"type": "integer", "minimum": 1, "maximum": 65535, "x-env": "NGINX_QA_HTTP_PORT"},
    "service_root": {"type": "string", "minLength": 1, "x-env": "NGINX_QA_SERVICE_ROOT"},
    "protected_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "x-env": "NGINX_QA_PROTECTED_ROOTS"
    },
    "runtime_root": {"type": "string", "minLength": 1, "x-env": "NGINX_QA_RUNTIME_ROOT"},
    "process_runtime_root": {
      "type": "string",
      "minLength": 1,
      "x-derived-from": "runtime_root/processes"
    },
    "log_root": {
      "type": "string",
      "minLength": 1,
      "x-derived-from": "runtime_root/logs"
    },
    "pid_root": {
      "type": "string",
      "minLength": 1,
      "x-derived-from": "runtime_root/pids"
    },
    "lease_root": {
      "type": "string",
      "minLength": 1,
      "x-derived-from": "runtime_root/leases"
    },
    "prompt_root": {"type": "string", "minLength": 1, "x-env": "NGINX_QA_PROMPT_ROOT"},
    "managed_root": {"type": "string", "minLength": 1, "x-env": "NGINX_QA_MANAGED_ROOT"},
    "git_fetch_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1800,
      "x-env": "NGINX_QA_GIT_FETCH_TIMEOUT_SECONDS"
    },
    "child_port_start": {"type": "integer", "minimum": 1, "maximum": 65535, "x-env": "NGINX_QA_CHILD_PORT_RANGE"},
    "child_port_end": {"type": "integer", "minimum": 1, "maximum": 65535, "x-env": "NGINX_QA_CHILD_PORT_RANGE"},
    "instance_id": {"type": "string", "minLength": 1, "maxLength": 128, "x-env": "NGINX_QA_INSTANCE_ID"},
    "disable_telegram": {"type": "boolean", "x-env": "NGINX_QA_DISABLE_TELEGRAM"},
    "disable_tunnel": {"type": "boolean", "x-env": "NGINX_QA_DISABLE_TUNNEL"}
  },
  "additionalProperties": false
}
