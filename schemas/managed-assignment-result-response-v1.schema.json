{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chartjs333/nginx-qa/schemas/managed-assignment-result-response-v1.schema.json",
  "title": "Managed assignment result response v1",
  "type": "object",
  "required": [
    "assignment_id",
    "outcome",
    "result_commit",
    "result_key",
    "status",
    "deduplicated"
  ],
  "properties": {
    "assignment_id": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "result_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "result_key": {"type": "string", "pattern": "^result-[0-9a-f]{64}$"},
    "status": {"enum": ["REVIEWS_PENDING", "ALREADY_ACCEPTED"]},
    "deduplicated": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "REVIEWS_PENDING"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"deduplicated": {"const": false}}
      },
      "else": {
        "properties": {"deduplicated": {"const": true}}
      }
    }
  ],
  "additionalProperties": false
}
