# Example Linux directory configuration. Replace with dedicated, native absolute
# paths before use. This file does not initialize staging ownership or start it.
# Windows deployments can retain .env.staging.example and their existing paths.
NGINX_QA_SERVICE_ROOT=/srv/nginx-qa-paths/service
NGINX_QA_PROTECTED_ROOTS=["/srv/nginx-qa-live"]
NGINX_QA_RUNTIME_ROOT=/srv/nginx-qa-paths/state/runtime
NGINX_QA_PROMPT_ROOT=/srv/nginx-qa-paths/state/managed-prompts
NGINX_QA_MANAGED_ROOT=/srv/nginx-qa-paths/state/managed
# Default for missing/invalid legacy prompt settings; persisted valid templates win.
NGINX_QA_SEQUENTIAL_PROMPT_ROOT=/srv/nginx-qa-paths/state/sequential-prompts
NGINX_QA_HTTP_HOST=127.0.0.1
NGINX_QA_HTTP_PORT=18025
NGINX_QA_CHILD_PORT_RANGE=18100-18199
NGINX_QA_GIT_FETCH_TIMEOUT_SECONDS=120
NGINX_QA_INSTANCE_ID=isolated-path-check
NGINX_QA_DISABLE_TELEGRAM=true
NGINX_QA_DISABLE_TUNNEL=true
