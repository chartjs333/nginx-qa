# Copy this file to .env and keep .env out of Git.
# Revoke any token that was pasted into chat or committed before using it here.
TELEGRAM_BOT_TOKEN=CHANGE_ME_WITH_A_NEW_BOTFATHER_TOKEN

# Random 1-256 character value using letters, digits, underscore, or hyphen.
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET

# Public HTTPS address routed to this application's Telegram endpoint.
TELEGRAM_WEBHOOK_URL=https://example.com/api/v1/telegram/agents

# Set to 1 to call Telegram setWebhook each time run.bat starts.
TELEGRAM_WEBHOOK_AUTO_REGISTER=0

# Set to 1 only when old pending bot messages should be discarded at registration.
TELEGRAM_DROP_PENDING_UPDATES=0

# Optional comma-separated allowlists. Telegram group chat IDs can be negative.
# At least one allowlist is strongly recommended for a bot that can mutate projects.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
